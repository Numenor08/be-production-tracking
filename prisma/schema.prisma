// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  IN_PROGRESS
  COMPLETED
  DELIVERED
  IDLE
}

enum ProcessStage {
  PREPROCESS
  PROCESS
  FINISHING
}

enum PalletStatus {
  NOT_READY
  READY
  SHIPPED
}

enum PhaseStatus {
  NOT_STARTED
  ONGOING
  COMPLETED
  SKIPPED
}

enum ItemType {
  MATERIAL
  SEMI_FINISHED
  PRODUCT
}

enum DeliveryStatus {
  PENDING
  IN_TRANSIT
  DELIVERED
}

enum UserRole {
  ADMIN
  OPERATOR
}

enum ProductionReportTag {
  STORAGE_USED
  WASTE_USED
  BELOW_TARGET
  FULL_PLANNED
  ABOVE_TARGET
  PALLET_CREATED
}

enum MutationType {
  ADD_STOCK      // Penambahan stok
  REDUCE_STOCK   // Pengurangan stok
  PRODUCTION     // Hasil produksi
  DELIVERY       // Pengiriman/surat jalan
  TRANSFER       // Transfer antar storage
  ADJUSTMENT     // Penyesuaian stok
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   @unique
  firstName String
  lastName  String?
  email     String  @unique
  phone     String?
  isActive  Boolean @default(true)
  role      UserRole @default(OPERATOR)
  report    ProductionReport[]
  stockMutations StockMutation[] @relation(name: "StockMutationToUser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String   @db.Text
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model Customer {
  id            String  @id @default(cuid())
  name          String
  address       String?
  phone         String?
  email         String?
  contactPerson String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  salesOrders    SalesOrder[]
}

model SalesOrder {
  id             String   @id @default(cuid())
  code           String   @unique
  totalPrice     Int
  completionDate DateTime
  deliveryDate   DateTime?
  status         OrderStatus      @default(IDLE)
  maxQuantityPerPallet Int @default(50) // Maximum quantity per pallet for this sales order

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          SalesOrderItem[]
  spk            SPK[]
  pallets        Pallet[]
  deliveryOrders DeliveryOrder?
  stockMutations StockMutation[] @relation(name: "StockMutationToSalesOrder")
}

model SPK {
  id                  String    @id @default(cuid())
  code                String    @unique
  preprocessDeadline  DateTime?
  processDeadline     DateTime?
  finishingDeadline   DateTime?
  preprocessMachineId String?
  processMachineId    String?
  finishingMachineId  String?

  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderId String
  salesOrderItem SalesOrderItem @relation("SalesOrderItemToSPK", fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  salesOrderItemId String
  targetQuantity       Int

  startStage ProcessStage @default(PREPROCESS)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  preprocessMachine Machine? @relation("PreprocessMachine", fields: [preprocessMachineId], references: [id], onDelete: SetNull)
  processMachine    Machine? @relation("ProcessMachine", fields: [processMachineId], references: [id], onDelete: SetNull)
  finishingMachine  Machine? @relation("FinishingMachine", fields: [finishingMachineId], references: [id], onDelete: SetNull)


  storageItems   Storage[]
  machineHistory MachineHistory[]
  spkItems       SPK_Item[]
  phases         SPK_Phase[]
  stockMutations StockMutation[] @relation(name: "StockMutationToSPK")
}

model SPK_Phase {
  id    String       @id @default(cuid())
  spk   SPK          @relation(fields: [spkId], references: [id], onDelete: Cascade)
  spkId String
  stage ProcessStage

  startDate      DateTime?
  completionDate DateTime?
  status         PhaseStatus @default(NOT_STARTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  spkItems      SPK_Item[]
  
  productionReport ProductionReport? @relation(name: "ProductionReportToSPK_Phase")

  @@unique([spkId, stage])
}

model SPK_Item {
  id String @id @default(cuid())

  spk   SPK    @relation(fields: [spkId], references: [id], onDelete: Cascade)
  spkId String

  phase   SPK_Phase @relation(fields: [phaseId], references: [id], onDelete: Cascade)
  phaseId String

  // One output item
  outputItem   Item?   @relation("OutputItem", fields: [outputItemId], references: [id], onDelete: SetNull)
  outputItemId String?

  // Multiple input items through the relation table
  inputItems SPK_InputItem[]

  type           ItemType

  outputQuantity Int @default(0)
  wasteQuantity  Int @default(0)

  // Target output quantity and waste
  targetOutputQuantity Int
  targetWaste    Int @default(0)

  storageUsed Int @default(0)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  productionReports ProductionReport[] @relation(name: "ProductionReportToSPK_Item")
}

// New model for input items (many-to-many relationship)
model SPK_InputItem {
  id String @id @default(cuid())
  
  // Relation to SPK_Item
  spkItem   SPK_Item @relation(fields: [spkItemId], references: [id], onDelete: Cascade)
  spkItemId String

  // Relation to Item
  inputItem   Item @relation(fields: [inputItemId], references: [id], onDelete: Cascade)
  inputItemId String

  inputQuantity Int
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([spkItemId, inputItemId])
}

model Storage {
  id    String @id @default(cuid())
  spk   SPK?    @relation(fields: [spkId], references: [id], onDelete: Cascade)
  spkId String?

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  spkStage ProcessStage?
  stock           Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  palletItems PalletItem[]
  stockMutations StockMutation[] @relation(name: "StockMutationToStorage")

  @@unique([spkId, itemId])
}

model Item {
  id    String   @id @default(cuid())
  code  String   @unique
  name  String   @unique
  type  ItemType
  price Int?

  salesOrderItems  SalesOrderItem[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  storageItems Storage[]
  inputItemRelations SPK_InputItem[] 
  outputItems  SPK_Item[]   @relation("OutputItem")
  pallets      Pallet[]     // Pallets that contain this item
  stockMutations StockMutation[] @relation(name: "StockMutationToItem")
}

model SalesOrderItem {
  id String @id @default(cuid())

  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderId String

  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  targetQuantity    Int
  remainingQuantity Int
  actualQuantity   Int @default(0)
  fullyPlanned      Boolean @default(false)

  spks SPK[] @relation("SalesOrderItemToSPK")

  @@unique([salesOrderId, itemId])
}

model Machine {
  id               String           @id @default(cuid())
  code             String           @unique
  name             String
  details          String   @db.TinyText
  type             ProcessStage
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  history          MachineHistory[]
  preprocessOrders SPK[]            @relation("PreprocessMachine")
  processOrders    SPK[]            @relation("ProcessMachine")
  finishingOrders  SPK[]            @relation("FinishingMachine")
}

model MachineHistory {
  id        String @id @default(cuid())
  machineId String
  machine Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  spkId     String
  spk     SPK     @relation(fields: [spkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  details   String

  @@unique([machineId, spkId])
}

model Pallet {
  id           String       @id @default(cuid())
  code         String       @unique
  status       PalletStatus @default(NOT_READY)
  qrCodeData   String?
  currentQuantity Int @default(0) // Current quantity in this pallet
  maxQuantity  Int // Maximum quantity this pallet can hold (copied from sales order)
  
  salesOrderId String
  salesOrder   SalesOrder  @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  
  itemId       String // The specific item type this pallet contains
  item         Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  deliveryOrderId String?
  deliveryOrder   DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id], onDelete: SetNull)
  items              PalletItem[]
  stockMutations     StockMutation[] @relation(name: "StockMutationToPallet")
}

model PalletItem {
  id       String @id @default(cuid())
  quantity Int

  palletId String
  pallet   Pallet @relation(fields: [palletId], references: [id], onDelete: Cascade)

  storageItemId String
  storageItem   Storage @relation(fields: [storageItemId], references: [id], onDelete: Cascade)

  @@unique([palletId, storageItemId])
}

model DeliveryOrder {
  id           String         @id @default(cuid())
  code         String         @unique
  deliveryDate DateTime
  status       DeliveryStatus @default(PENDING)

  salesOrderId String @unique
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pallets Pallet[]
  stockMutations StockMutation[] @relation(name: "StockMutationToDeliveryOrder")
}

model StockMutation {
  id          String   @id @default(cuid())
  code        String   @unique
  
  // Type of mutation
  type        MutationType
  
  // Item information
  itemId      String
  item        Item     @relation(name: "StockMutationToItem", fields: [itemId], references: [id], onDelete: Cascade)
  
  // Storage information
  storageId   String?
  storage     Storage? @relation(name: "StockMutationToStorage", fields: [storageId], references: [id], onDelete: SetNull)
  
  // Mutation details
  quantityBefore  Int     // Stok sebelum mutasi
  quantityChange  Int     // Perubahan (+/-)
  quantityAfter   Int     // Stok setelah mutasi
  
  // Reference information
  spkId           String?
  spk             SPK?    @relation(name: "StockMutationToSPK", fields: [spkId], references: [id], onDelete: SetNull)
  
  salesOrderId    String?
  salesOrder      SalesOrder? @relation(name: "StockMutationToSalesOrder", fields: [salesOrderId], references: [id], onDelete: SetNull)
  
  deliveryOrderId String?
  deliveryOrder   DeliveryOrder? @relation(name: "StockMutationToDeliveryOrder", fields: [deliveryOrderId], references: [id], onDelete: SetNull)
  
  palletId        String?
  pallet          Pallet? @relation(name: "StockMutationToPallet", fields: [palletId], references: [id], onDelete: SetNull)
  
  productionReportId String?
  productionReport   ProductionReport? @relation(name: "StockMutationToProductionReport", fields: [productionReportId], references: [id], onDelete: SetNull)
  
  // User who performed the action
  performedByUserId String?
  performedByUser   User?    @relation(name: "StockMutationToUser", fields: [performedByUserId], references: [id], onDelete: SetNull)
  
  // Additional information
  notes       String?
  stage       ProcessStage?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductionReport {
  id          String   @id @default(cuid())
  code        String   @unique
  spkPhaseId  String @unique
  spkPhase SPK_Phase @relation(name: "ProductionReportToSPK_Phase", fields: [spkPhaseId], references: [id], onDelete: Cascade)


  stage       ProcessStage
  
  // User attribution
  confirmedByUserId String?
  confirmedByUser   User?    @relation(fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  confirmedDate     DateTime?

  // Related models
  spkItemId        String
  spkItem          SPK_Item @relation(name: "ProductionReportToSPK_Item", fields: [spkItemId], references: [id], onDelete: Cascade)
  
  // Metrics summary
  targetQuantity       Int
  actualQuantity       Int
  wasteQuantity        Int
  totalStorageUsed     Int

  // Additional data
  notes             String?
  
  // Tags as JSON array for multiple conditions
  tags              Json?
  
  // Computation results
  differenceToTarget Int // Negative = below target, Positive = above target with waste considered

  stockMutations    StockMutation[] @relation(name: "StockMutationToProductionReport")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}