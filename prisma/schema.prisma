// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Sales_Order {
  id            String   @id @default(cuid())
  customer_name String
  product_qty   Int
  finish_date   DateTime
  delivery_date DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products SalesOrderProduct[]
  spk      SPK?                @relation(fields: [spkId], references: [id])
  spkId    String?             @unique
}

model SPK {
  id          String       @id @default(cuid())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  Sales_Order Sales_Order?
}

model Material {
  id            String   @id @default(cuid())
  material_name String
  price         Int
  stock         Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  products ProductMaterial[]
}

model Product {
  id           String   @id @default(cuid())
  product_name String
  price        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  materials   ProductMaterial[]
  salesOrders SalesOrderProduct[]
}

model ProductMaterial {
  id        String  @id @default(cuid())
  product   Product @relation(fields: [productId], references: [id])
  productId String

  material   Material @relation(fields: [materialId], references: [id])
  materialId String

  stock_needed Int

  @@unique([productId, materialId])
}

model SalesOrderProduct {
  id           String      @id @default(cuid())
  salesOrder   Sales_Order @relation(fields: [salesOrderId], references: [id])
  salesOrderId String

  product   Product @relation(fields: [productId], references: [id])
  productId String

  product_qty Int
  price       Int

  @@unique([salesOrderId, productId])
}
