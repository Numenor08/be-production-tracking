// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  IN_PROGRESS
  SPLIT_PROCESSING
  COMPLETED
  IDLE
}

enum ProcessStage {
  PREPROCESS
  PROCESS
  FINISHING
}

enum PalletStatus {
  READY
  SHIPPED
}

enum PhaseStatus {
  NOT_STARTED
  ONGOING
  COMPLETED
  SKIPPED
}

enum ItemType {
  MATERIAL
  SEMI_FINISHED
  PRODUCT
}

model SalesOrder {
  id              String   @id @default(cuid())
  code            String   @unique
  customerName    String
  totalPrice      Int
  completionDate  DateTime
  deliveryDate    DateTime

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           SalesOrderItem[]
  productionOrders SPK[]
  status          OrderStatus      @default(IDLE)
  pallets         Pallet[]
}

model SPK {
  id                       String    @id @default(cuid())
  code                     String    @unique
  preprocessDeadline       DateTime?
  processDeadline          DateTime?
  finishingDeadline        DateTime?
  preprocessMachineId      String?
  processMachineId         String?
  finishingMachineId       String?

  startStage               ProcessStage @default(PREPROCESS)

  preprocessStatus         PhaseStatus @default(NOT_STARTED)
  processStatus            PhaseStatus @default(NOT_STARTED)
  finishingStatus          PhaseStatus @default(NOT_STARTED)

  preprocessStartDate      DateTime?
  processStartDate         DateTime?
  finishingStartDate       DateTime?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  preprocessMachine        Machine? @relation("PreprocessMachine", fields: [preprocessMachineId], references: [id])
  processMachine           Machine? @relation("ProcessMachine", fields: [processMachineId], references: [id])
  finishingMachine         Machine? @relation("FinishingMachine", fields: [finishingMachineId], references: [id])

  salesOrder               SalesOrder    @relation(fields: [salesOrderId], references: [id])
  salesOrderId             String
  storageItems             Storage[]
  machineHistory           MachineHistory[]
  productionItems          ProductionItem[]
  phases                   SPK_Phase[]
  report                   Report?
  palletItems              PalletItem[]
}

model SPK_Phase {
  id              String       @id @default(cuid())
  productionOrder SPK @relation(fields: [productionOrderId], references: [id])
  productionOrderId String
  stage           ProcessStage

  targetQuantity  Int
  plannedWaste    Int @default(0)

  actualQuantity  Int @default(0)
  actualWaste     Int @default(0)

  storageUsed     Int @default(0)

  itemId         String
  item           Item @relation(fields: [itemId], references: [id])

  startDate       DateTime?
  completionDate  DateTime?
  status          PhaseStatus @default(NOT_STARTED)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productionOrderId, stage])
}

model Report {
  id                      String @id @default(cuid())

  preprocessDetails       String?
  processDetails          String?
  finishingDetails        String?

  preprocessCompletionDate DateTime?
  processCompletionDate    DateTime?
  finishingCompletionDate  DateTime?

  // Add phase result summaries
  preprocessSummary       Json?
  processSummary          Json?
  finishingSummary        Json?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  productionOrderId       String          @unique
  productionOrder         SPK @relation(fields: [productionOrderId], references: [id])
  reportItems             ReportItem[]
}

model ReportItem {
  id              String @id @default(cuid())

  report          Report @relation(fields: [reportId], references: [id])
  reportId        String

  item            Item? @relation(fields: [itemId], references: [id])
  itemId         String?

  phase           ProcessStage
  itemType        ItemType

  quantity        Int
  wasteQuantity   Int
  storageUsed     Int

  notes           String?

  @@unique([reportId, itemId, phase])
}

model Storage {
  id              String @id @default(cuid())
  stock           Int
  wasteStock      Int    @default(0)

  itemId         String
  item           Item @relation(fields: [itemId], references: [id])

  productionOrderId String?
  productionOrder   SPK? @relation(fields: [productionOrderId], references: [id])
  productionStage   ProcessStage?

  isWaste         Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  palletItems     PalletItem[]
}

model Item {
  id              String   @id @default(cuid())
  name            String
  type            ItemType
  price           Int

  salesOrderItems SalesOrderItem[]
  productionPhases SPK_Phase[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  storageItems    Storage[]
  inputItems      ProductionItem[] @relation("InputItem")
  outputItems     ProductionItem[] @relation("OutputItem")
  reportItems     ReportItem[]
}

model SalesOrderItem {
  id              String @id @default(cuid())

  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id])
  salesOrderId    String

  item            Item? @relation(fields: [itemId], references: [id])
  itemId         String?

  quantity        Int

  @@unique([salesOrderId, itemId])
}

model Machine {
  id                   String         @id @default(cuid())
  name                 String
  details              String
  type                 ProcessStage
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  history              MachineHistory[]
  preprocessOrders     SPK[] @relation("PreprocessMachine")
  processOrders        SPK[] @relation("ProcessMachine")
  finishingOrders      SPK[] @relation("FinishingMachine")
}

model ProductionItem {
  id                   String @id @default(cuid())

  productionOrder      SPK @relation(fields: [productionOrderId], references: [id])
  productionOrderId    String

  inputItem            Item @relation("InputItem", fields: [inputItemId], references: [id])
  inputItemId          String

  outputItem           Item @relation("OutputItem", fields: [outputItemId], references: [id])
  outputItemId         String

  type                 Int
  inputQuantity        Int
  outputQuantity       Int
}

model MachineHistory {
  id                   String @id @default(cuid())
  machineId            String
  productionOrderId    String

  machine              Machine @relation(fields: [machineId], references: [id])
  productionOrder      SPK @relation(fields: [productionOrderId], references: [id])

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  status               Int
  details              String

  @@unique([machineId, productionOrderId])
}

model Pallet {
  id                   String      @id @default(cuid())
  code                 String      @unique
  status               PalletStatus @default(READY) // READY, SHIPPED
  qrCodeData           String      @unique
  salesOrderId         String
  salesOrder           SalesOrder  @relation(fields: [salesOrderId], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items                PalletItem[]
}

model PalletItem {
  id                   String @id @default(cuid())
  quantity             Int

  palletId             String
  pallet               Pallet @relation(fields: [palletId], references: [id], onDelete: Cascade)

  storageItemId        String
  storageItem          Storage @relation(fields: [storageItemId], references: [id])

  productionOrderId    String
  productionOrder      SPK @relation(fields: [productionOrderId], references: [id])

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([palletId, storageItemId, productionOrderId])
}