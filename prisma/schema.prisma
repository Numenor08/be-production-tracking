// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  IN_PROGRESS
  SPLIT_PROCESSING
  COMPLETED
  IDLE
}

enum ProcessStage {
  PREPROCESS
  PROCESS
  FINISHING
}

enum PalletStatus {
  READY
  SHIPPED
}

enum PhaseStatus {
  NOT_STARTED
  ONGOING
  COMPLETED
  SKIPPED
}

enum ItemType {
  MATERIAL
  SEMI_FINISHED
  PRODUCT
}

model SalesOrder {
  id              String   @id @default(cuid())
  code            String   @unique
  customerName    String
  totalPrice      Int
  completionDate  DateTime
  deliveryDate    DateTime

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           SalesOrderItem[]
  productionOrders SPK[]
  status          OrderStatus      @default(IDLE)
  pallets         Pallet[]
}

model SPK {
  id                       String    @id @default(cuid())
  code                     String    @unique
  preprocessDeadline       DateTime?
  processDeadline          DateTime?
  finishingDeadline        DateTime?
  preprocessMachineId      String?
  processMachineId         String?
  finishingMachineId       String?

  // Track starting stage
  startStage               ProcessStage @default(PREPROCESS)

  // Phase status tracking
  preprocessStatus         PhaseStatus @default(NOT_STARTED)
  processStatus            PhaseStatus @default(NOT_STARTED)
  finishingStatus          PhaseStatus @default(NOT_STARTED)

  // Date tracking for each stage
  preprocessStartDate      DateTime?
  processStartDate         DateTime?
  finishingStartDate       DateTime?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  preprocessMachine        Machine? @relation("PreprocessMachine", fields: [preprocessMachineId], references: [id])
  processMachine           Machine? @relation("ProcessMachine", fields: [processMachineId], references: [id])
  finishingMachine         Machine? @relation("FinishingMachine", fields: [finishingMachineId], references: [id])

  salesOrder               SalesOrder    @relation(fields: [salesOrderId], references: [id])
  salesOrderId             String
  storageItems             Storage[]
  machineHistory           MachineHistory[]
  productionItems          ProductionItem[]
  phases                   SPK_Phase[]
  report                   Report?
  palletItems              PalletItem[]
}

model SPK_Phase {
  id              String       @id @default(cuid())
  productionOrder SPK @relation(fields: [productionOrderId], references: [id])
  productionOrderId String
  stage           ProcessStage

  // Target quantities
  targetQuantity  Int
  plannedWaste    Int @default(0)

  // Actual quantities
  actualQuantity  Int @default(0)
  actualWaste     Int @default(0)

  // Tracking if storage was used to meet shortfall
  storageUsed     Int @default(0)

  productId       String // The output product of this phase
  product         Product @relation(fields: [productId], references: [id])

  startDate       DateTime?
  completionDate  DateTime?
  status          PhaseStatus @default(NOT_STARTED)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([productionOrderId, stage])
}

model Report {
  id                      String @id @default(cuid())

  // Add information per phase
  preprocessDetails       String? // Detailed notes for preprocess
  processDetails          String? // Detailed notes for process
  finishingDetails        String? // Detailed notes for finishing

  // Existing data
  preprocessCompletionDate DateTime?
  processCompletionDate    DateTime?
  finishingCompletionDate  DateTime?

  // Add phase result summaries
  preprocessSummary       Json? // Store preprocess summary data 
  processSummary          Json? // Store process summary data
  finishingSummary        Json? // Store finishing summary data

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  productionOrderId       String          @unique
  productionOrder         SPK @relation(fields: [productionOrderId], references: [id])
  reportItems             ReportItem[]
}

model ReportItem {
  id              String @id @default(cuid())

  report          Report @relation(fields: [reportId], references: [id])
  reportId        String

  product         Product? @relation(fields: [productId], references: [id])
  productId       String?

  phase           ProcessStage // Production phase of this item
  itemType        ItemType // Keep this field

  // Quantity data
  quantity        Int // Keep this field
  wasteQuantity   Int // Amount of waste produced
  storageUsed     Int // Storage used to cover shortfall

  // Additional notes (e.g., reasons for high waste)
  notes           String?

  @@unique([reportId, productId, phase])
}

model Storage {
  id              String @id @default(cuid())
  stock           Int
  wasteStock      Int    @default(0) // Track waste separately

  productId       String
  product         Product @relation(fields: [productId], references: [id])

  // Track which production order and phase produced this inventory
  productionOrderId String?
  productionOrder   SPK? @relation(fields: [productionOrderId], references: [id])
  productionStage   ProcessStage?

  isWaste         Boolean @default(false)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  palletItems     PalletItem[]
}

model Product {
  id              String   @id @default(cuid())
  name            String
  type            ItemType
  price           Int

  salesOrderItems SalesOrderItem[]
  productionPhases SPK_Phase[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  storageItems    Storage[]
  inputItems      ProductionItem[] @relation("InputProduct")
  outputItems     ProductionItem[] @relation("OutputProduct")
  reportItems     ReportItem[]
}

model SalesOrderItem {
  id              String @id @default(cuid())

  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id])
  salesOrderId    String

  product         Product? @relation(fields: [productId], references: [id])
  productId       String?

  quantity        Int

  @@unique([salesOrderId, productId])
}

model Machine {
  id                   String         @id @default(cuid())
  name                 String
  details              String
  type                 ProcessStage
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  history              MachineHistory[]
  preprocessOrders     SPK[] @relation("PreprocessMachine")
  processOrders        SPK[] @relation("ProcessMachine")
  finishingOrders      SPK[] @relation("FinishingMachine")
}

model ProductionItem {
  id                   String @id @default(cuid())

  productionOrder      SPK @relation(fields: [productionOrderId], references: [id])
  productionOrderId    String

  inputProduct         Product @relation("InputProduct", fields: [inputProductId], references: [id])
  inputProductId       String

  outputProduct        Product @relation("OutputProduct", fields: [outputProductId], references: [id])
  outputProductId      String

  type                 Int
  inputQuantity        Int
  outputQuantity       Int
}

model MachineHistory {
  id                   String @id @default(cuid())
  machineId            String
  productionOrderId    String

  machine              Machine @relation(fields: [machineId], references: [id])
  productionOrder      SPK @relation(fields: [productionOrderId], references: [id])

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  status               Int
  details              String

  @@unique([machineId, productionOrderId])
}

model Pallet {
  id                   String      @id @default(cuid())
  code                 String      @unique
  status               PalletStatus @default(READY) // READY, SHIPPED
  qrCodeData           String      @unique
  salesOrderId         String
  salesOrder           SalesOrder  @relation(fields: [salesOrderId], references: [id])
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items                PalletItem[]
}

model PalletItem {
  id                   String @id @default(cuid())
  quantity             Int

  palletId             String
  pallet               Pallet @relation(fields: [palletId], references: [id], onDelete: Cascade)

  storageItemId        String
  storageItem          Storage @relation(fields: [storageItemId], references: [id])

  productionOrderId    String
  productionOrder      SPK @relation(fields: [productionOrderId], references: [id])

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([palletId, storageItemId, productionOrderId])
}