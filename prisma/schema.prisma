// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  IN_PROGRESS
  SPLIT_PROCESSING
  COMPLETED
  IDLE
}

enum ProcessStage {
  PREPROCESS
  PROCESS
  FINISHING
}

enum PalletStatus {
  READY
  SHIPPED
}

enum PhaseStatus {
  NOT_STARTED
  ONGOING
  COMPLETED
  SKIPPED
}

enum ItemType {
  MATERIAL
  SEMI_FINISHED
  PRODUCT
}

model SalesOrder {
  id              String   @id @default(cuid())
  code            String   @unique
  customerName    String
  totalPrice      Int
  completionDate  DateTime
  deliveryDate    DateTime

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  items           SalesOrderItem[]
  spk             SPK[]
  pallets         Pallet[]
  status          OrderStatus      @default(IDLE)
}

model SPK {
  id                       String    @id @default(cuid())
  code                     String    @unique
  preprocessDeadline       DateTime?
  processDeadline          DateTime?
  finishingDeadline        DateTime?
  preprocessMachineId      String?
  processMachineId         String?
  finishingMachineId       String?

  startStage               ProcessStage @default(PREPROCESS)

  preprocessStatus         PhaseStatus @default(NOT_STARTED)
  processStatus            PhaseStatus @default(NOT_STARTED)
  finishingStatus          PhaseStatus @default(NOT_STARTED)

  preprocessStartDate      DateTime?
  processStartDate         DateTime?
  finishingStartDate       DateTime?

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  preprocessMachine        Machine? @relation("PreprocessMachine", fields: [preprocessMachineId], references: [id])
  processMachine           Machine? @relation("ProcessMachine", fields: [processMachineId], references: [id])
  finishingMachine         Machine? @relation("FinishingMachine", fields: [finishingMachineId], references: [id])

  salesOrder               SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderId             String
  storageItems             Storage[]
  machineHistory           MachineHistory[]
  productionItems          ProductionItem[]
  phases                   SPK_Phase[]
  report                   Report?
  palletItems              PalletItem[]
}

model SPK_Phase {
  id              String       @id @default(cuid())
  spk             SPK @relation(fields: [spkId], references: [id])
  spkId          String
  stage           ProcessStage

  targetQuantity  Int
  plannedWaste    Int @default(0)

  actualQuantity  Int @default(0)
  actualWaste     Int @default(0)

  storageUsed     Int @default(0)

  itemId         String
  item           Item @relation(fields: [itemId], references: [id])

  startDate       DateTime?
  completionDate  DateTime?
  status          PhaseStatus @default(NOT_STARTED)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([spkId, stage])
}

model Report {
  id                      String @id @default(cuid())

  preprocessDetails       String?
  processDetails          String?
  finishingDetails        String?

  preprocessCompletionDate DateTime?
  processCompletionDate    DateTime?
  finishingCompletionDate  DateTime?

  // Add phase result summaries
  preprocessSummary       Json?
  processSummary          Json?
  finishingSummary        Json?

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  spkId                   String          @unique
  spk                     SPK @relation(fields: [spkId], references: [id])
  reportItems             ReportItem[]
}

model ReportItem {
  id              String      @id @default(cuid())
  
  report          Report      @relation(fields: [reportId], references: [id])
  reportId        String
  
  item            Item        @relation(fields: [itemId], references: [id])
  itemId          String
  
  storage         Storage?    @relation(fields: [storageId], references: [id])
  storageId       String?
  
  phase           ProcessStage
  quantity        Int
  wasteQuantity   Int         @default(0)
  
  storageUsed     Int         @default(0)
  
  notes           String?

  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model Storage {
  id                String      @id @default(cuid())
  spk               SPK         @relation(fields: [spkId], references: [id])
  spkId             String
  
  item              Item        @relation(fields: [itemId], references: [id])
  itemId            String
  
  productionStage   ProcessStage
  stock             Int         @default(0)
  wasteStock        Int         @default(0)
  
  isWaste           Boolean     @default(false)
  
  reportItems       ReportItem[]
  
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  
  palletItems       PalletItem[]
  
  @@unique([spkId, itemId, productionStage, isWaste])
}

model Item {
  id              String   @id @default(cuid())
  name            String
  type            ItemType
  price           Int?

  salesOrderItems SalesOrderItem[]
  productionPhases SPK_Phase[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  storageItems    Storage[]
  inputItems      ProductionItem[] @relation("InputItem")
  outputItems     ProductionItem[] @relation("OutputItem")
  reportItems     ReportItem[]
}

model SalesOrderItem {
  id              String @id @default(cuid())

  salesOrder      SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  salesOrderId    String

  item            Item? @relation(fields: [itemId], references: [id])
  itemId         String?

  quantity        Int
  remainingQuantity Int @default(0)
  fullyPlanned      Boolean @default(false)

  @@unique([salesOrderId, itemId])
}

model Machine {
  id                   String         @id @default(cuid())
  name                 String
  details              String
  type                 ProcessStage
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  history              MachineHistory[]
  preprocessOrders     SPK[] @relation("PreprocessMachine")
  processOrders        SPK[] @relation("ProcessMachine")
  finishingOrders      SPK[] @relation("FinishingMachine")
}

model ProductionItem {
  id                   String @id @default(cuid())

  spk                  SPK @relation(fields: [spkId], references: [id])
  spkId                String

  inputItem            Item @relation("InputItem", fields: [inputItemId], references: [id])
  inputItemId          String

  outputItem           Item @relation("OutputItem", fields: [outputItemId], references: [id])
  outputItemId         String

  type                 ItemType
  inputQuantity        Int
  outputQuantity       Int
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model MachineHistory {
  id                   String @id @default(cuid())
  machineId            String
  spkId                String

  machine              Machine @relation(fields: [machineId], references: [id], onDelete: Cascade)
  spk                  SPK @relation(fields: [spkId], references: [id])

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  status               Int
  details              String

  @@unique([machineId, spkId])
}

model Pallet {
  id                   String      @id @default(cuid())
  code                 String      @unique
  status               PalletStatus @default(READY)
  qrCodeData           String      @unique
  salesOrderId         String?
  salesOrder           SalesOrder?  @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  items                PalletItem[]
}

model PalletItem {
  id                   String @id @default(cuid())
  quantity             Int

  palletId             String
  pallet               Pallet @relation(fields: [palletId], references: [id], onDelete: Cascade)

  storageItemId        String
  storageItem          Storage @relation(fields: [storageItemId], references: [id])

  spkId                String
  spk                  SPK @relation(fields: [spkId], references: [id])

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([palletId, storageItemId, spkId])
}