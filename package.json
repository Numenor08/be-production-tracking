{
  "name": "be-production-tracking",
  "version": "1.0.0",
  "description": "Backend for Production Tracking Service",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "dev": "nodemon --watch src --ext ts,json --exec ts-node src/server.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "schema:force": "npx prisma db push --force-reset && npx prisma generate",
    "seed:admin": "ts-node src/utils/seedAdmin.ts",
    "lint": "eslint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.9.0",
  "dependencies": {
    "@quixo3/prisma-session-store": "^3.1.13",
    "@types/bcryptjs": "^3.0.0",
    "@types/express-session": "^1.18.2",
    "@types/node-cron": "^3.0.11",
    "bcryptjs": "^3.0.2",
    "colors": "^1.4.0",
    "connect-session-sequelize": "^8.0.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.2.1",
    "jest": "^29.7.0",
    "node-cron": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@prisma/client": "6.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.2",
    "dotenv": "^16.5.0",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.2.6",
    "globals": "^16.0.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "prisma": "6.9.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.31.0"
  }
}
